	/** Draws the given digit on the screen in the given location. */
	function void drawDigit(int digit, int location) {
		if (digit = 0) {
			do Numbers.drawZero(location);
		}
		if (digit = 1) {
			do Numbers.drawOne(location);
		}
		if (digit = 2) {
			do Numbers.drawTwo(location);
		}
		if (digit = 3) {
			do Numbers.drawThree(location);
		}
		if (digit = 4) {
			do Numbers.drawFour(location);
		}
		if (digit = 5) {
			do Numbers.drawFive(location);
		}
		if (digit = 6) {
			do Numbers.drawSix(location);
		}
		if (digit = 7) {
			do Numbers.drawSeven(location);
		}
		if (digit = 8) {
			do Numbers.drawEight(location);
		}
		if (digit = 9) {
			do Numbers.drawNine(location);
		}
		return;
	}

	/** Draws the given number of points on the screen next to the score heading. */
	function void drawPoints(int points) {
		var int digitOffset;
		var int digit;
		var int location;
		var int i;
		var Array reversedNumber;
		var int length;

		let location = 6;

		let digitOffset = 1;
		let length = MathUtils.numLength(points);
		let reversedNumber = MathUtils.reverseNumber(points, length);
		let i = length - 1;
		let length = 0;

		while (i > -1) {
			let digit = reversedNumber[i];
			do Text.drawDigit(digit, location + length * digitOffset);
			let i = i - 1;
			let length = length + 1;
		}

		do reversedNumber.dispose();

		return;
	}

}